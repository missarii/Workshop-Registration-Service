# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workshop_registration
DB_USER=postgres
DB_PASSWORD=your_password_here

# Session secret — use a long random string in production
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# Server
PORT=3000
NODE_ENV=development

# Timezone for workshop date display
TZ=Asia/Colombo
